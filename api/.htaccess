RewriteEngine On

# ===== CORS HEADERS =====
Header set Access-Control-Allow-Origin "*"
Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"

# ===== HANDLE PREFLIGHT OPTIONS =====
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# ===== SERVE STATIC FILES (HTML, CSS, JS, IMAGES) =====
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ===== SERVE EXISTING DIRECTORIES =====
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ===== API VIEWS (PHP) =====
# ✅ SỬA: index.html → index.php
RewriteRule ^views/?$ views/index.php [L]
RewriteRule ^views/(.*)$ views/$1 [L]

# ===== CATEGORY API =====
RewriteRule ^categories/([0-9]+)$ CategoryAPI.php?id=$1 [QSA,L]
RewriteRule ^categories$ CategoryAPI.php [QSA,L]

# ===== PRODUCT API =====
RewriteRule ^products/([0-9]+)$ ProductAPI.php?id=$1 [QSA,L]
RewriteRule ^products$ ProductAPI.php [QSA,L]

# ===== ACCOUNT API =====
RewriteRule ^accounts/([0-9]+)$ AccountAPI.php?id=$1 [QSA,L]
RewriteRule ^accounts$ AccountAPI.php [QSA,L]

# ===== ORDER API =====
RewriteRule ^orders/([0-9]+)$ OrderAPI.php?id=$1 [QSA,L]
RewriteRule ^orders$ OrderAPI.php [QSA,L]

# ===== AUTH API (LOGIN/REGISTER) =====
RewriteRule ^auth$ LoginAPI.php [QSA,L]
RewriteRule ^auth/(.+)$ LoginAPI.php?action=$1 [QSA,L]

# Cart API
RewriteRule ^cart$ CartAPI.php [QSA,L]
RewriteRule ^cart/(.+)$ CartAPI.php?action=$1 [QSA,L]
RewriteRule ^cart/([0-9]+)$ CartAPI.php?id=$1 [QSA,L]

# Payment API
RewriteRule ^payment$ PaymentAPI.php [QSA,L]
RewriteRule ^payment/(.+)$ PaymentAPI.php?action=$1 [QSA,L]
RewriteRule ^payment/([0-9]+)$ PaymentAPI.php?id=$1 [QSA,L]

# Auth API
RewriteRule ^auth$ AuthAPI.php [QSA,L]
RewriteRule ^auth/(.+)$ AuthAPI.php?action=$1 [QSA,L]